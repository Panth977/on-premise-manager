/**
 * Generates ../api_gen.go from shared/src so the Go router cannot drift from CLOUD_API.
 *   cd shared && node --import tsx ../agent/internal/cloud/gen/gen.mts [--stdout]
 * TestGeneratedTableFresh (agent/internal/cloud) fails when the checked-in file is stale.
 */
import { writeFileSync } from 'node:fs';
import { CLOUD_API } from '../../../../shared/src/cloud-api.ts';
import { AUDIT_DEPLOYMENT_OPS, AUDIT_EXEMPT_OPS, AUDIT_OPS, CREDENTIAL_OPS, ERROR_HTTP_STATUS, REVEAL_RATE_PER_MINUTE } from '../../../../shared/src/types.ts';
import { LIMITS } from '../../../../shared/src/validate.ts';
import { DEVELOPER_RESOURCES, IMPLICIT_READ, RESOURCES, VALID_ACTIONS } from '../../../../shared/src/access.ts';

const q = (s: string) => JSON.stringify(s);
const strs = (l: readonly string[]) => `[]string{${l.map(q).join(', ')}}`;
const out: string[] = ['// Code generated by agent/internal/cloud/gen/gen.mts from shared/src. DO NOT EDIT.', '', 'package cloud', ''];
out.push('// cloudAPI is CLOUD_API in table order (the router sorts it like core/router.ts).', 'var cloudAPI = []Endpoint{');
for (const [op, d] of Object.entries(CLOUD_API) as [string, { method: string; path: string; auth: string; perm: string | null; body: string; res: string; ok?: number }][]) {
  out.push(`\t{Op: ${q(op)}, Method: ${q(d.method)}, Path: ${q(d.path)}, Auth: ${q(d.auth)}, Perm: ${q(d.perm ?? '')}, Body: ${q(d.body)}, Res: ${q(d.res)}, OK: ${d.ok ?? 200}},`);
}
out.push('}', '');
out.push(`var credentialOps = ${strs(CREDENTIAL_OPS)}`, '');
out.push(`var auditExemptOps = ${strs(AUDIT_EXEMPT_OPS)}`, '');
out.push(`var auditDeploymentOps = ${strs(AUDIT_DEPLOYMENT_OPS)}`, '');
out.push('var auditOps = map[string]auditSpec{');
for (const [op, s] of Object.entries(AUDIT_OPS) as [string, { action: string; targetType: string }][]) out.push(`\t${q(op)}: {${q(s.action)}, ${q(s.targetType)}},`);
out.push('}', '');
out.push('var errorHTTPStatus = map[string]int{');
for (const [c, n] of Object.entries(ERROR_HTTP_STATUS)) out.push(`\t${q(c)}: ${n},`);
out.push('}', '');
out.push(`const revealRatePerMinute = ${REVEAL_RATE_PER_MINUTE}`, '');
out.push('// Limits is LIMITS of shared/src/validate.ts.', 'var Limits = map[string]int{');
for (const [k, v] of Object.entries(LIMITS)) out.push(`\t${q(k)}: ${v as number},`);
out.push('}', '');
out.push(`var developerResources = ${strs(DEVELOPER_RESOURCES)}`, '');
out.push(`var allResources = ${strs(RESOURCES)}`, '');
out.push(`var implicitRead = ${strs(IMPLICIT_READ)}`, '');
out.push('var validActions = map[string][]string{');
for (const r of RESOURCES) out.push(`\t${q(r)}: ${strs(VALID_ACTIONS[r])},`);
out.push('}', '');
const text = out.join('\n');
if (process.argv.includes('--stdout')) process.stdout.write(text);
else writeFileSync(new URL('../api_gen.go', import.meta.url), text);
