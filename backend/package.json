{
  "name": "opm-backend",
  "private": true,
  "type": "module",
  "description": "opm-cloud: TS sources in src, bundled into dist/opm-cloud.cjs by build-server.mjs.",
  "scripts": {
    "build": "node build-server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && scripts/test-local.sh",
    "create-admin": "tsx scripts/create-admin.ts",
    "upload-agent": "tsx scripts/upload-agent.ts",
    "migrate-c": "tsx scripts/migrate-c.ts",
    "migrate-d": "tsx scripts/migrate-d.ts",
    "migrate-e": "tsx scripts/migrate-e.ts",
    "migrate-h": "tsx scripts/migrate-h.ts",
    "verify-schema": "tsx scripts/verify-schema.ts",
    "migrate-k": "tsx scripts/migrate-k.ts",
    "migrate-m": "tsx scripts/migrate-m.ts",
    "export-branch": "tsx scripts/export-branch.ts",
    "start:local": "node --no-warnings=ExperimentalWarning dist/opm-cloud.cjs serve",
    "test:adapters": "node --import tsx --test --test-concurrency=1 test/40-adapter-conformance.test.ts test/41-local-adapter.test.ts"
  },
  "devDependencies": {
    "@opm/shared": "file:../shared",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "hash-wasm": "^4.12.0",
    "nodemailer": "^10.0.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "version": "0.16.0"
}
