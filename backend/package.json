{
  "name": "opm-backend",
  "private": true,
  "type": "module",
  "description": "OPM cloud backend dev workspace: TS sources in functions/src, bundled into functions/lib by build.mjs.",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && scripts/emu.sh exec \"node --import tsx --test --test-concurrency=1 --test-timeout=600000 test/*.test.ts\"",
    "test:only": "node --import tsx --test --test-concurrency=1 --test-timeout=600000 test/*.test.ts",
    "emulators": "npm run build && scripts/emu.sh start",
    "create-admin": "tsx scripts/create-admin.ts",
    "upload-agent": "tsx scripts/upload-agent.ts",
    "deploy": "npm run build && firebase deploy --only functions,firestore,storage --project your-firebase-project && npm run cors && npm run lifecycle",
    "cors": "gcloud storage buckets update gs://your-firebase-project.firebasestorage.app --cors-file=storage.cors.json --project your-firebase-project",
    "cors:show": "gcloud storage buckets describe gs://your-firebase-project.firebasestorage.app --format=json(cors_config)",
    "lifecycle": "gcloud storage buckets update gs://your-firebase-project.firebasestorage.app --lifecycle-file=storage.lifecycle.json --project your-firebase-project",
    "lifecycle:show": "gcloud storage buckets describe gs://your-firebase-project.firebasestorage.app --format='json(lifecycle_config)'",
    "migrate-c": "tsx scripts/migrate-c.ts",
    "migrate-d": "tsx scripts/migrate-d.ts",
    "migrate-e": "tsx scripts/migrate-e.ts",
    "migrate-h": "tsx scripts/migrate-h.ts",
    "verify-schema": "tsx scripts/verify-schema.ts",
    "migrate-k": "tsx scripts/migrate-k.ts",
    "export-branch": "tsx scripts/export-branch.ts",
    "build:server": "node build.mjs && node build-server.mjs",
    "start:local": "node --no-warnings=ExperimentalWarning dist/opm-cloud.cjs serve",
    "test:local": "npm run build:server && scripts/test-local.sh",
    "test:adapters": "node --import tsx --test --test-concurrency=1 test/40-adapter-conformance.test.ts test/41-local-adapter.test.ts"
  },
  "devDependencies": {
    "@opm/shared": "file:../shared",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "hash-wasm": "^4.12.0",
    "nodemailer": "^10.0.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "version": "0.16.0"
}
