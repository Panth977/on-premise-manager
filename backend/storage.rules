rules_version = '2';
// OPM: Cloud Storage is touched ONLY by the backend (Admin SDK). Deny every client read and write
// (incl. staging/<stageId>/: §21 #107 commit stages; storage.lifecycle.json deletes them after 1 day).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
