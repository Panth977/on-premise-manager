{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@opm/shared": ["../shared/src/index.ts"] }
  },
  "include": ["functions/src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
