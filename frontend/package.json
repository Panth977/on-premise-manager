{
  "name": "opm-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "VITE_MOCK=1 vite dev",
    "dev:emu": "VITE_USE_EMULATORS=1 vite dev",
    "build": "vite build",
    "build:mock": "VITE_MOCK=1 vite build --outDir build-mock",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:e2e": "playwright test",
    "test:e2e:mock": "OPM_E2E_MODE=mock playwright test",
    "test:e2e:emu": "OPM_E2E_MODE=emu playwright test",
    "screenshots": "OPM_E2E_MODE=mock OPM_SCREENSHOTS=1 playwright test tests/screenshots.spec.ts",
    "deploy": "npm run build && firebase deploy --only hosting --project your-firebase-project",
    "test:e2e:prod": "OPM_E2E_MODE=prod playwright test",
    "test:bundle": "npm run build && node scripts/check-bundle-text.mjs build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@lezer/highlight": "^1.2.0",
    "@opm/shared": "file:../shared",
    "firebase": "^12.19.0",
    "hash-wasm": "^4.12.0",
    "lucide": "^1.52.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
