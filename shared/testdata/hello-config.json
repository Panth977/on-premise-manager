        "generate": {
          "charset": "alnum",
          "length": 24
        },
        "value": "Zx8Kq2Lm9Np4Rs7Tv1Wy3Ab5",
        "rotatedAt": "2026-10-07T10:00:00.000Z"
      }
    ],
    "files": [
      {
        "fileSlug": "banner",
        "label": "Banner text",
