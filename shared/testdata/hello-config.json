        "variableSlug": "theme",
        "label": "Page theme",
        "description": "Colour of the hello page",
        "type": "enum",
        "value": "green",
        "required": true,
        "options": [
          "green",
          "yellow",
          "blue",
          "red"
        ],
        "validation": null
      },
      {
        "variableSlug": "greeting",
        "label": "Greeting",
        "description": "",
        "type": "string",
        "value": "Hello from OPM",
        "required": false,
        "options": null,
        "validation": null
      },
      {
        "variableSlug": "redis-host-port",
        "label": "Redis host port",
        "description": "Published on site db",
        "type": "number",
        "value": 16379,
        "required": true,
        "options": null,
        "validation": {
          "min": 1024,
          "max": 65535,
          "pattern": null
